model SuspiciousUser {
  userId  Int @id
  reason String?
  status SuspiciousStatus @default(underReview)
  lastSeen DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  observations Observation[]

  @@index([status])
  @@map("suspicious_users")
}

enum SuspiciousStatus {
  underReview
  cleared
}

model Observation {
  id Int @id @default(autoincrement())
  suspiciousUserId Int
  ruleId Int?
  logId BigInt?
  scoreIncrease Float
  note String?
  actionJson Json?
  createdAt DateTime @default(now())

  suspiciousUser SuspiciousUser @relation(fields: [suspiciousUserId], references: [userId], onDelete: Cascade)
  rule DetectionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  log Log? @relation(fields: [logId], references: [id], onDelete: SetNull)

  @@index([suspiciousUserId])
  @@index([ruleId])
  @@index([createdAt])
  @@map("observations")
}

model DetectionRule {
  id  Int @id @default(autoincrement())
  key String @unique
  name String
  description String?
  enabled Boolean @default(true)
  weight Float @default(1)
  params Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  observations Observation[]

  @@index([enabled])
  @@map("detection_rules")
}

